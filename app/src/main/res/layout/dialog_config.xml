<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 1-Tap Quick Presets"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap a button below to auto-fill all fields:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <!-- Quick Presets Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogReplitPreset"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="🌐 Replit Mode"
                android:textColor="@color/primary"
                android:textSize="12sp"
                app:backgroundTint="@color/accent"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDialogColabPreset"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="📓 Colab Mode"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/card_bg"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- Field 1: Target URL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🌐 Target Workspace URL"
            app:boxStrokeColor="@color/accent"
            app:hintTextColor="@color/accent"
            app:boxBackgroundColor="@color/card_bg"
            app:helperText="Paste your Replit or Google Colab link here"
            app:helperTextTextColor="@color/text_secondary"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="textUri"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Field 2: Custom Selector -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="🎯 Target Button CSS Selector"
            app:boxStrokeColor="@color/accent"
            app:hintTextColor="@color/accent"
            app:boxBackgroundColor="@color/card_bg"
            app:helperText="Replit: [action=&quot;run_button_used&quot;] | Colab: colab-run-button"
            app:helperTextTextColor="@color/text_secondary"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="text"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Field 3: Interval -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="⏱️ Auto-Click Watcher Interval (Seconds)"
            app:boxStrokeColor="@color/accent"
            app:hintTextColor="@color/accent"
            app:boxBackgroundColor="@color/card_bg"
            app:helperText="Replit: 8-15 seconds | Colab: 30-60 seconds"
            app:helperTextTextColor="@color/text_secondary"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:inputType="number"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>
</ScrollView>
